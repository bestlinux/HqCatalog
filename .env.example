# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com)
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Autenticação de Acesso ao Sistema (Login Básico)
APP_USERNAME=admin
APP_PASSWORD=sua_senha_segura_aqui

# (Opcional) Banco na Nuvem Permanente com Turso (obtenha gratuitamente em https://turso.tech)
# Se não preenchido, o app usa automaticamente o SQLite local (hqs_inventario.db)
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu_token_aqui

# (Opcional) Chave da SerpApi para pesquisa de preços no Google Shopping (https://serpapi.com)
# SERPAPI_API_KEY=sua_chave_serpapi_aqui
